{
  "version": 3,
  "exported_by": "turnout 0.12.0",
  "apps": [
    {
      "name": "api",
      "path": "C:\\dev\\api",
      "commands": {
        "build": "cargo build --release"
      },
      "servers": []
    },
    {
      "name": "web",
      "path": "C:\\dev\\web",
      "commands": {
        "build": "npm run build",
        "dev": "npm run dev"
      },
      "dist_dir": "dist",
      "gateway_port": 7150,
      "servers": [
        "staging",
        "prod"
      ]
    }
  ],
  "servers": [
    {
      "name": "lab",
      "url": "https://lab.example.com",
      "port": 22,
      "accept_invalid_certs": true
    },
    {
      "name": "prod",
      "url": "https://app.example.com",
      "host": "deploy.example.com",
      "port": 2222,
      "accept_invalid_certs": false,
      "credential": "ci-key"
    },
    {
      "name": "staging",
      "label": "Staging",
      "url": "https://staging.example.com",
      "port": 22,
      "accept_invalid_certs": false,
      "credential": "deploy"
    }
  ],
  "credentials": [
    {
      "name": "ci-key",
      "user": "ci",
      "auth": "key",
      "key": "C:\\dev\\keys\\id_ed25519"
    },
    {
      "name": "deploy",
      "user": "deploy",
      "auth": "password"
    }
  ],
  "paths": [
    {
      "name": "api-dir",
      "dir": "/srv/api"
    },
    {
      "name": "site",
      "dir": "/var/www/site",
      "restart": "systemctl restart site"
    }
  ],
  "groups": [
    {
      "name": "everything",
      "apps": [
        "web",
        "api"
      ]
    }
  ],
  "targets": [
    {
      "name": "api-prod",
      "app": "api",
      "server": "prod",
      "credential": "deploy",
      "path": "api-dir"
    },
    {
      "name": "web-staging",
      "app": "web",
      "server": "staging",
      "credential": "deploy",
      "path": "site"
    }
  ],
  "secrets": {
    "kdf": {
      "algorithm": "argon2id",
      "salt": "n/jql4Zf4jexjlYc0C0vOQ==",
      "memory_kib": 65536,
      "iterations": 3,
      "parallelism": 4
    },
    "nonce": "7NZh+iWtRLpdJOL6",
    "ciphertext": "/H1VJKd8HHPWj/RMvCrt+FEJhQQTtMAVwWGRZmPzJrxeKA3rcgG/c+K2c8ODx4GTjYPao4H1aK4t7FnSeiquB7DCu6C6MYLBeLSSfhaI2w=="
  }
